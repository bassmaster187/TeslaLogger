{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/panel-plugin.schema.json",
  "type": "panel",
  "name": "TrackMap",
  "id": "pr0ps-trackmap-panel",
  "info": {
    "description": "A panel plugin for Grafana that visualizes GPS points as a line on an interactive map.",
    "author": {
